    {
      "name": "01 GET all books (defaults)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response body is correct', function () { const b = pm.response.json(); pm.expect(b).to.be.an('array'); pm.expect(b.length).to.be.at.most(10); pm.expect(b[0].id).to.eql(1); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        }
      }
    },
